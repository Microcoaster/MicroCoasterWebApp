<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="env" content="<%= process.env.NODE_ENV || 'production' %>">
  <title><%= t('timelines.title') %> - <%= t('common.app_name') %></title>
  <link rel="stylesheet" href="/css/bootstrap-grid.min.css">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/timelines.css">
  <link rel="shortcut icon" href="/assets/ico/favicon.ico" type="image/x-icon"/>
</head>
<body>
  <%- include('partials/mobile-overlays') %>
  <%- include('partials/navbar', { currentPage: 'timelines', user: user }) %>

  <!-- Mobile Block Overlay -->
  <div class="mobile-block-overlay" id="mobile-block-overlay">
    <div class="mobile-block-content">
      <div class="mobile-block-icon">
        <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
          <line x1="12" y1="18" x2="12.01" y2="18"/>
        </svg>
        <div class="mobile-block-cross">
          <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
        </div>
      </div>
      <h2 class="mobile-block-title"><%= t('mobile.feature_not_available') %></h2>
      <p class="mobile-block-message"><%= t('mobile.timelines_desktop_only') %></p>
      <p class="mobile-block-submessage"><%= t('mobile.use_desktop') %></p>
      <a href="/dashboard" class="btn mobile-block-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        <%= t('mobile.return_dashboard') %>
      </a>
    </div>
  </div>

  <div class="container-fluid main-content">
    <main class="content">
      <section class="card panels">
        <div class="container-fluid">
          <div class="row">
            <div class="col-12">
              <header class="page-header">
                <h1 class="page-title"><%= t('timelines.timeline_sequencer') %></h1>
                <div class="page-actions">
                  <div id="autoSaveIndicator" class="auto-save-indicator" style="display: none;"></div>
                  <div class="timeline-viewport-info">
                    <span class="viewport-indicator" id="viewportIndicator">0s - 30s</span>
                    <small class="viewport-help">Shift+molette: naviguer | Ctrl+molette: zoom</small>
                  </div>
                  <div class="play-controls">
                    <button id="playFromStartBtn" class="btn btn-primary" title="Lire du début">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 18L8.5 12L4 6V18ZM13 6V18L21.5 12L13 6Z" fill="currentColor"/>
                      </svg>
                    </button>
                    <button id="playPauseBtn" class="btn" title="Lecture/Pause">
                      <svg id="playPauseIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8 5V19L19 12L8 5Z" fill="currentColor"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </header>
            </div>
          </div>

          <div class="row">
            <div class="col-12">
              <div class="timeline-app">
                <div class="sidebar-panel">
                  <div class="sidebar-tabs">
                    <button id="modulesTab" class="sidebar-tab active">
                      <i class="bi bi-cpu"></i>
                      <%= t('timelines.modules') %>
                    </button>
                    <button id="savedTimelinesTab" class="sidebar-tab">
                      <i class="bi bi-clock-history"></i>
                      <%= t('timelines.saved') %>
                    </button>
                  </div>
                  
                  <div class="sidebar-content">
                    <div class="modules-panel active" id="modulesPanel">
                      <div class="modules-list">
                        <% modules.forEach(module => { %>
                          <div class="module-item" 
                               draggable="true"
                               data-module-id="<%= module.module_id.replace(/"/g, '&quot;') %>"
                               data-module-name="<%= (module.name || '').replace(/"/g, '&quot;') %>"
                               data-module-type="<%= module.type || '' %>"
                               data-is-online="<%= module.isOnline %>">
                            
                            <div class="module-header">
                              <div class="module-main-line">
                                <div class="module-name"><%= module.name || module.module_id %></div>
                                <span class="state <%= module.isOnline ? 'online' : 'offline' %>">
                                  <%= module.isOnline ? t('common.online') : t('common.offline') %>
                                </span>
                              </div>
                              <div class="module-secondary-line">
                                <div class="module-type"><%= module.type %></div>
                                <div class="module-id"><%= module.module_id %></div>
                              </div>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>

                    <div class="saved-timelines-panel" id="savedTimelinesPanel">
                      <button class="create-timeline-btn" id="createTimelineBtn">
                        <i class="bi bi-plus-circle"></i>
                        <%= t('timelines.create_timeline') %>
                      </button>
                      <div class="saved-timelines-list">
                        <!-- Les timelines sauvegardées seront chargées dynamiquement -->
                        <div class="empty-state">
                          <div>
                            <h3><%= t('timelines.no_saved_timelines') %></h3>
                            <p><%= t('timelines.save_first_timeline') %></p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="timeline-container">
                  <div class="timeline-workspace">
                    <div class="timeline-track" id="timelineTrack">
                      <!-- Pistes de timeline -->
                      <div class="timeline-tracks">
                        <div class="timeline-track-lane" data-track-index="0">
                          <div class="track-label">Piste 1</div>
                        </div>
                        <div class="timeline-track-lane" data-track-index="1">
                          <div class="track-label">Piste 2</div>
                        </div>
                        <div class="timeline-track-lane" data-track-index="2">
                          <div class="track-label">Piste 3</div>
                        </div>
                        <div class="timeline-track-lane" data-track-index="3">
                          <div class="track-label">Piste 4</div>
                        </div>
                        <div class="timeline-track-lane" data-track-index="4">
                          <div class="track-label">Piste 5</div>
                        </div>
                        <div class="timeline-track-lane" data-track-index="5">
                          <div class="track-label">Piste 6</div>
                        </div>
                        <div class="timeline-track-lane" data-track-index="6">
                          <div class="track-label">Piste 7</div>
                        </div>
                        <div class="timeline-track-lane" data-track-index="7">
                          <div class="track-label">Piste 8</div>
                        </div>
                      </div>
                      
                      <div class="time-markers" id="timeMarkers">
                      </div>
                      
                      <div class="playback-indicator" id="playbackIndicator"></div>
                      <div class="timeline-instructions" id="instructions">
                        <h4><%= t('timelines.create_sequence') %></h4>
                        <p><%= t('timelines.drag_modules_here') %></p>
                        <p><%= t('timelines.click_module_configure') %></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <div class="modal create-timeline-modal" id="createTimelineModal">
    <div class="modal-card">
      <div class="modal-header">
        <h3 class="modal-title"><%= t('timelines.create_timeline') %></h3>
        <button class="close-btn" id="closeCreateTimelineBtn">&times;</button>
      </div>

      <form id="createTimelineForm">
        <div class="form-row">
          <label class="form-label" for="timelineName"><%= t('timelines.timeline_name') %></label>
          <input type="text" class="input" id="timelineName" name="timelineName"
                 placeholder="<%= t('timelines.timeline_name_placeholder') || 'Ma nouvelle chronologie' %>"
                 maxlength="100" autocomplete="off" required>
          <small class="form-help"><%= t('timelines.timeline_name_help') || 'Choisissez un nom descriptif pour votre chronologie' %></small>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" id="cancelCreateTimelineBtn"><%= t('common.cancel') %></button>
          <button type="submit" class="btn btn-primary" id="createTimelineSubmitBtn"><%= t('timelines.create_timeline') %></button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal delete-timeline-modal" id="deleteTimelineModal">
    <div class="modal-card">
      <div class="modal-header">
        <h3 class="modal-title">Supprimer la timeline</h3>
        <button class="close-btn" id="closeDeleteTimelineBtn">&times;</button>
      </div>

      <div class="modal-body">
        <p>Êtes-vous sûr de vouloir supprimer cette timeline ?</p>
        <p class="modal-warning">Cette action est irréversible.</p>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-danger" id="cancelDeleteTimelineBtn">Non</button>
        <button type="button" class="btn btn-success" id="confirmDeleteTimelineBtn">Oui</button>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/global.js"></script>
  <script src="/js/language.js"></script>
  <script src="/js/timelines.js"></script>
  <script>
    // Modules disponibles pour la logique côté client
    window.availableModules = <%- JSON.stringify(modules) %>;

    // Traductions pour le JavaScript
    window.timelineTranslations = {
      noSavedTimelines: "<%= t('timelines.no_saved_timelines') %>",
      saveFirstTimeline: "<%= t('timelines.save_first_timeline') %>",
      noModulesYet: "<%= t('modules.no_modules_yet') %>",
      addFirstModule: "<%= t('modules.add_first_module') %>",
      playTimeline: "<%= t('timelines.play_timeline') %>",
      stopTimeline: "<%= t('timelines.stop_timeline') %>",
      playing: "Lecture en cours...",
      play_from_start: "<%= t('timelines.play_from_start') || 'Lire du début' %>",
      play_pause: "<%= t('timelines.play_pause') || 'Lecture/Pause' %>",
      pause: "<%= t('timelines.pause') || 'Pause' %>",
      resume: "<%= t('timelines.resume') || 'Reprendre' %>",
      select_timeline_first: "<%= t('timelines.select_timeline_first') %>",
      create_or_select_timeline: "<%= t('timelines.create_or_select_timeline') %>",
      create_sequence: "<%= t('timelines.create_sequence') %>",
      drag_modules_here: "<%= t('timelines.drag_modules_here') %>",
      click_module_configure: "<%= t('timelines.click_module_configure') %>",
      autoSavePending: "<%= t('timelines.autoSavePending') %>",
      autoSaveSaving: "<%= t('timelines.autoSaveSaving') %>",
      autoSaveSaved: "<%= t('timelines.autoSaveSaved') %>",
      autoSaveError: "<%= t('timelines.autoSaveError') %>"
    };

    // Mobile detection and blocking for timelines page
    (function() {
      function checkMobileAccess() {
        const isMobile = window.isMobileDevice ? window.isMobileDevice() : 
          (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || 
          window.innerWidth <= 768);
        
        const overlay = document.getElementById('mobile-block-overlay');
        const mainContent = document.querySelector('.main-content');
        
        if (isMobile && overlay) {
          overlay.style.display = 'flex';
          if (mainContent) {
            mainContent.style.display = 'none';
          }
          document.body.style.overflow = 'hidden';
        } else if (overlay) {
          overlay.style.display = 'none';
          if (mainContent) {
            mainContent.style.display = 'block';
          }
          document.body.style.overflow = '';
        }
      }
      
      // Check on load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', checkMobileAccess);
      } else {
        checkMobileAccess();
      }
      
      // Check on resize
      window.addEventListener('resize', checkMobileAccess);
    })();
  </script>
</body>
</html>